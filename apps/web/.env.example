# URL of the bookmarks API. Empty = same origin (Vite proxies /api to :8787 in dev).
VITE_API_URL=
# Public link to your bot, shown on the sign-in screen and empty state
VITE_BOT_URL=https://t.me/your_bot
# 1 = render local fixtures without a backend (UI development)
VITE_DEMO=0
# 1 = dev-only: let the API use DEV_TELEGRAM_ID instead of initData
VITE_DEV_AUTH=0
